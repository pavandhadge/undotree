{
  "name": "RewindCode",
  "publisher": "PavanDhadgeandTeam",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:csharp",
    "onLanguage:rust",
    "onLanguage:swift",
    "onLanguage:kotlin",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:bash",
    "onLanguage:go",
    "onCommand:undotree.undo",
    "onCommand:undotree.redo",
    "onCommand:undotree.saveAndAdvance",
    "onCommand:undotree.resetTree",
    "onCommand:undotree.toggleTimecode",
    "onCommand:rewindcode.recommendations"
  ],
  "displayName": "RewindCode",
  "description": "Navigate code history with tree-based undo/redo and smart function recommendations",
  "version": "0.2.2",
  "icon": "./images/image.png",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pavandhadge/undotree"
  },
  "main": "./src/extension.js",
  "contributes": {
    "menus": {
      "view/title": [
        {
          "command": "undotree.undo",
          "when": "view == undoTreeView",
          "group": "navigation@1"
        },
        {
          "command": "undotree.redo",
          "when": "view == undoTreeView",
          "group": "navigation@2"
        },
        {
          "command": "undotree.saveAndAdvance",
          "when": "view == undoTreeView",
          "group": "navigation@3"
        },
        {
          "command": "undotree.resetTree",
          "when": "view == undoTreeView",
          "group": "navigation@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "undoTreeContainer",
          "title": "Undo Tree",
          "icon": "$(timeline-view-icon)"
        }
      ]
    },
    "views": {
      "undoTreeContainer": [
        {
          "id": "undoTreeView",
          "name": "Undo Tree",
          "contextualTitle": "Undo Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "undotree.undo",
        "title": "Undo Tree: Undo",
        "icon": "$(arrow-small-up)"
      },
      {
        "command": "undotree.redo",
        "title": "Undo Tree: Redo",
        "icon": "$(arrow-small-down)"
      },
      {
        "command": "undotree.saveAndAdvance",
        "title": "Undo Tree: Save and Advance",
        "icon": "$(save)"
      },
      {
        "command": "undotree.resetTree",
        "title": "Undo Tree: Reset",
        "icon": "$(refresh)"
      },
      {
        "command": "undotree.toggleTimecode",
        "title": "Undo Tree: Toggle Showing Timecode"
      },
      {
        "command": "rewindcode.recommendations",
        "title": "RewindCode: Show Previous Versions"
      }
    ],
    "keybindings": [
      {
        "command": "undotree.undo",
        "key": "alt+z",
        "when": "editorTextFocus"
      },
      {
        "command": "undotree.redo",
        "key": "alt+y",
        "when": "editorTextFocus"
      },
      {
        "command": "undotree.saveAndAdvance",
        "key": "alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "rewindcode.recommendations",
        "key": "alt+r",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext js",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.54.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@swc/core": "^1.11.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-bash": "^0.23.3",
    "tree-sitter-c": "^0.23.5",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.23.2",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.23.2",
    "tree-sitter-swift": "^0.7.0"
  },
  "overrides": {
    "tree-sitter": "^0.22.4"
  }
}
